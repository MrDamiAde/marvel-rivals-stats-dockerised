{
  "family": "marvel-rivals-task",
  "networkMode": "awsvpc",
  "executionRoleArn": "arn:aws:iam::635920908966:role/ecsTaskExecutionRole",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "containerDefinitions": [
    {
      "name": "marvel-rivals-web",
      "image": "635920908966.dkr.ecr.eu-west-2.amazonaws.com/marvel-rivals-stats",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 5000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "POSTGRES_HOST", "value": "marvel-rivals-db.c3gesceykptv.eu-west-2.rds.amazonaws.com" },
        { "name": "POSTGRES_DB", "value": "marvel" },
        { "name": "POSTGRES_USER", "value": "postgres" },
        { "name": "POSTGRES_PASSWORD", "value": "example" }
      ]
    }
  ]
}
